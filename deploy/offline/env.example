# OpsPilot 离线安装参数模板（install.sh 会读取/覆盖本文件）
# 拷到安装目录后修改，或直接运行 install.sh 交互填写。

# ── 目录与项目 ──────────────────────────────────────────────
INSTALL_DIR=/opt/opspilot
OPSPILOT_PROJECT=opspilot

# ── 访问地址 / 端口 ─────────────────────────────────────────
# 浏览器访问前端的地址（反代 /api）
PUBLIC_URL=http://192.168.1.10:8080
FRONTEND_PORT=8080
BACKEND_PORT=8001

# ── 数据库 ──────────────────────────────────────────────────
POSTGRES_USER=opspilot
POSTGRES_DB=opspilot
# 至少 24 字符；不得使用示例或常见口令。
POSTGRES_PASSWORD=

# ── 应用密钥（必填强随机；更换 CREDENTIAL_ENCRYPTION_KEY 会导致已存凭证无法解密）─
SECRET_KEY=
# 必须与 SECRET_KEY 不同；更换前先运行凭证密文迁移工具。
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# 按实际反向代理容器/网段配置，禁止使用 0.0.0.0/0。
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# 内网 K8s/API 按最小范围填写，例如 10.20.30.0/24；不要填 0.0.0.0/0。
OUTBOUND_ALLOWED_HOSTS=
OUTBOUND_ALLOWED_CIDRS=
OUTBOUND_TIMEOUT_SECONDS=30
OUTBOUND_MAX_RESPONSE_BYTES=4194304
OUTBOUND_MAX_REDIRECTS=3

# ── 初始管理员 ─────────────────────────────────────────────
INIT_ADMIN_USERNAME=admin
# 至少 24 字符，且需同时包含大小写字母、数字和符号。
INIT_ADMIN_PASSWORD=
INIT_ADMIN_NAME=系统管理员
INIT_ADMIN_EMAIL=admin@opspilot.local
INIT_ADMIN_ROLE=管理员
INIT_ADMIN_DEPARTMENT=基础平台部

# ── 监控（分体或同机均可；同机 MONITORING_HOST 可填 127.0.0.1 或本机 IP）─
INSTALL_MONITORING=true
# 监控机地址（应用后端用来查询 VM/VLogs；Agent 写入也要业务机可达）
# 注意：不要填 WireGuard wg0 的 /32 地址（本机 curl 自己会超时），用网卡 LAN IP
MONITORING_HOST=
# Alloy 内置采集标签：HOST_INSTANCE 对齐 MONITORING_HOST（资产表本机 IP）
HOST_NAME=
VM_PORT=8428
VLOGS_PORT=9428
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# 至少 24 字符。
GRAFANA_ADMIN_PASSWORD=
# Grafana 裸端口仅绑定本机；业务后端走专用 Docker 网络，不经宿主机端口。
GRAFANA_BIND=127.0.0.1
OPSPILOT_MONITORING_SUBNET=172.30.250.0/24
GRAFANA_AUTH_PROXY_WHITELIST=172.30.250.0/24
# 默认仅本机；跨机部署应填写明确的受控私网 IP，禁止 0.0.0.0。
MONITOR_BIND=127.0.0.1
VM_RETENTION=30d
VLOGS_RETENTION=7d
VM_MAX_DISK_BYTES=53687091200
VLOGS_MAX_DISK_BYTES=21474836480
ALLOY_IMAGE=grafana/alloy:v1.16.3

# 精确覆盖（可选；空则用 MONITORING_HOST 推导）
VM_URL=
VLOGS_URL=
GRAFANA_URL=

# ── 镜像（离线包内默认 tag，一般无需改）────────────────────
OPSPILOT_BACKEND_IMAGE=opspilot/backend:1.0.0
OPSPILOT_FRONTEND_IMAGE=opspilot/frontend:1.0.0
VM_IMAGE=victoriametrics/victoria-metrics:v1.140.0
VLOGS_IMAGE=victoriametrics/victoria-logs:v1.50.0
GRAFANA_IMAGE=grafana/grafana:11.6.14-security-04
