# OpsPilot 离线安装参数模板（install.sh 会读取/覆盖本文件）
# 拷到安装目录后修改，或直接运行 install.sh 交互填写。

# ── 目录与项目 ──────────────────────────────────────────────
INSTALL_DIR=/opt/opspilot
OPSPILOT_PROJECT=opspilot

# ── 访问地址 / 端口 ─────────────────────────────────────────
# 浏览器访问前端的地址（反代 /api）
PUBLIC_URL=http://192.168.1.10:8080
FRONTEND_PORT=8080
BACKEND_PORT=8001

# ── 数据库 ──────────────────────────────────────────────────
POSTGRES_USER=opspilot
POSTGRES_DB=opspilot
POSTGRES_PASSWORD=

# ── 应用密钥（必填强随机；更换 CREDENTIAL_ENCRYPTION_KEY 会导致已存凭证无法解密）─
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# ── 初始管理员 ─────────────────────────────────────────────
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=
INIT_ADMIN_NAME=系统管理员
INIT_ADMIN_EMAIL=admin@opspilot.local
INIT_ADMIN_ROLE=管理员
INIT_ADMIN_DEPARTMENT=基础平台部

# ── 监控（分体或同机均可；同机 MONITORING_HOST 可填 127.0.0.1 或本机 IP）─
INSTALL_MONITORING=true
# 监控机地址（应用后端用来查询 VM/VLogs；Agent 写入也要业务机可达）
# 注意：不要填 WireGuard wg0 的 /32 地址（本机 curl 自己会超时），用网卡 LAN IP
MONITORING_HOST=
# Alloy 内置采集标签：HOST_INSTANCE 对齐 MONITORING_HOST（资产表本机 IP）
HOST_NAME=
VM_PORT=8428
VLOGS_PORT=9428
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# 0.0.0.0 允许跨机访问；仅本机可用 127.0.0.1
MONITOR_BIND=0.0.0.0
VM_RETENTION=30d
VLOGS_RETENTION=7d
ALLOY_IMAGE=grafana/alloy:v1.16.3

# 精确覆盖（可选；空则用 MONITORING_HOST 推导）
VM_URL=
VLOGS_URL=
GRAFANA_URL=

# ── 镜像（离线包内默认 tag，一般无需改）────────────────────
OPSPILOT_BACKEND_IMAGE=opspilot/backend:1.0.0
OPSPILOT_FRONTEND_IMAGE=opspilot/frontend:1.0.0
VM_IMAGE=victoriametrics/victoria-metrics:v1.140.0
VLOGS_IMAGE=victoriametrics/victoria-logs:v1.50.0
GRAFANA_IMAGE=grafana/grafana:11.0.0
