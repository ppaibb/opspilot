GEMINI_API_KEY=
OPENAI_COMPAT_API_KEY=
ANTHROPIC_API_KEY=
SECRET_KEY=replace-with-a-strong-random-secret-key
CREDENTIAL_ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 数据库连接串（必填）。统一使用 PostgreSQL，格式：
# postgresql+psycopg://<用户>:<密码>@<主机>:<端口>/<库名>
DATABASE_URL=postgresql+psycopg://opspilot:change-this-db-password@127.0.0.1:5432/opspilot
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-this-admin-password
INIT_ADMIN_NAME=系统管理员
INIT_ADMIN_EMAIL=admin@opspilot.local
# 兼容 admin / administrator，会自动映射为内置“管理员”权限组。
INIT_ADMIN_ROLE=管理员
INIT_ADMIN_DEPARTMENT=基础平台部
TERMINAL_SFTP_UPLOAD_MAX_MB=100
